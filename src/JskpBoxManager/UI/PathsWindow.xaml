<Window x:Class="JskpBoxManager.UI.PathsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="路径设置" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13" Icon="/app.ico">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Foreground="#4B5563" Margin="0,0,0,14"
                   Text="一般不用改：程序会自动识别。只有识别错了或装在特殊位置时才需要手动指定。留空 = 自动识别。设置保存在程序目录的 paths.json。"/>

        <TextBlock Text="QQ 浏览器（QQBrowser.exe）" FontWeight="SemiBold"/>
        <DockPanel Margin="0,4,0,4">
            <Button DockPanel.Dock="Right" Content="浏览…" Style="{StaticResource Btn}" Margin="8,0,0,0" Padding="12,4" Click="BrowseQq_Click"/>
            <TextBox x:Name="TxtQq" Padding="5,4"/>
        </DockPanel>
        <TextBlock x:Name="LblQq" Foreground="#6B7280" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <TextBlock Text="Sandboxie-Plus（Start.exe）" FontWeight="SemiBold"/>
        <DockPanel Margin="0,4,0,4">
            <Button DockPanel.Dock="Right" Content="浏览…" Style="{StaticResource Btn}" Margin="8,0,0,0" Padding="12,4" Click="BrowseSbie_Click"/>
            <TextBox x:Name="TxtSbie" Padding="5,4"/>
        </DockPanel>
        <TextBlock x:Name="LblSbie" Foreground="#6B7280" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <TextBlock Text="沙箱根目录（Sandboxie 的 FileRootPath，不含沙箱名）" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtRoot" Padding="5,4" Margin="0,4,0,4"/>
        <TextBlock x:Name="LblRoot" Foreground="#6B7280" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="全部恢复自动识别" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Auto_Click"/>
            <Button Content="保存" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Padding="22,7" Click="Save_Click"/>
            <Button Content="取消" Style="{StaticResource Btn}" Margin="0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
