<Window x:Class="JskpBoxManager.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="620" Height="520" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13" Icon="/app.ico">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtSub" Foreground="#4B5563" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar x:Name="Bar" Height="8" Margin="0,0,0,6" Visibility="Collapsed" Maximum="1"/>
            <TextBlock x:Name="TxtProgress" Foreground="#4B5563" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="在网页上查看" Style="{StaticResource LinkBtn}" VerticalAlignment="Center" Click="Page_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSkip" Content="跳过这个版本" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Skip_Click"/>
                    <Button x:Name="BtnLater" Content="以后再说" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Later_Click"/>
                    <Button x:Name="BtnUpdate" Content="立即更新" Style="{StaticResource PrimaryBtn}" Margin="0" Padding="22,7" Click="Update_Click"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="更新内容" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Background="#F9FAFB">
            <RichTextBox x:Name="TxtNotes" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" Padding="4"/>
        </Border>
    </DockPanel>
</Window>
