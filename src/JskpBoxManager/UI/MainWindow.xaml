<Window x:Class="JskpBoxManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="向僵多开管家" Width="1280" Height="760" MinWidth="1040" MinHeight="580"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="White" Icon="/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#0F172A" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="向僵多开管家" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtVersion" Foreground="#94A3B8" Margin="10,5,0,0" Text="v1.0.0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnNewVersion" Visibility="Collapsed" Style="{StaticResource LinkBtn}" Foreground="#4ADE80" FontWeight="SemiBold" Margin="0,0,20,0" Click="NewVersion_Click"/>
                    <TextBlock x:Name="TxtEnv" Foreground="#CBD5E1" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <Button Content="导入旧版数据" Style="{StaticResource LinkBtn}" Foreground="#93C5FD" Click="Import_Click"/>
                    <Button Content="路径设置" Style="{StaticResource LinkBtn}" Foreground="#93C5FD" Click="Paths_Click"/>
                    <Button Content="导出诊断包" Style="{StaticResource LinkBtn}" Foreground="#93C5FD" Click="Diag_Click"/>
                    <Button Content="版本与更新记录" Style="{StaticResource LinkBtn}" Foreground="#93C5FD" Click="About_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 提醒横幅 -->
        <Border Grid.Row="1" x:Name="Banner" Visibility="Collapsed" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1" Padding="18,8">
            <DockPanel>
                <Button x:Name="BannerBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="12,0,0,0" Padding="12,4" Click="BannerBtn_Click"/>
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#92400E"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="16,14,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 沙箱列表 -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <CheckBox x:Name="ChkGlobalKeep" Content="静默保活总开关" VerticalAlignment="Center" Margin="0,0,14,0" Click="GlobalKeep_Click"/>
                        <Button Content="＋ 新建沙箱" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="NewBox_Click"/>
                        <Button Content="刷新" Style="{StaticResource Btn}" Margin="0" Click="Refresh_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="沙箱列表" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Text="每个沙箱登录一个微信号；按住 Ctrl / Shift 可多选后批量启动、停止或设置保活"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderBrush="{StaticResource Border}"
                          RowHeight="38" SelectionMode="Extended" SelectionUnit="FullRow" CanUserResizeRows="False"
                          Background="White" RowBackground="White" AlternatingRowBackground="White"
                          SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DCFCE7"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="沙箱" Binding="{Binding Box}" Width="66"/>
                        <DataGridTextColumn Header="账号备注" Binding="{Binding Note}" Width="*" MinWidth="100"/>
                        <DataGridTemplateColumn Header="角色" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RoleText}" ToolTip="{Binding RoleTip}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="攻击力" Binding="{Binding AttackText}" Width="80"/>
                        <DataGridTemplateColumn Header="运行状态" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{Binding PhaseBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding PhaseText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PhaseText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="登录" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding LoginBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LoginText}" Foreground="{Binding LoginFg}" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="最近免扫换新" Binding="{Binding RenewText}" Width="100"/>
                        <DataGridTextColumn Header="保活计划" Binding="{Binding Keepalive}" Width="100"/>
                        <DataGridTextColumn Header="上次保活" Binding="{Binding LastRefresh}" Width="120"/>
                        <DataGridTemplateColumn Header="" Width="28">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="⚠" Foreground="{StaticResource Warn}" ToolTip="{Binding Warning}" Visibility="{Binding WarningVisibility}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- 右侧详情 -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <StackPanel x:Name="Detail">
                        <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold" Text="请选择一个沙箱" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailSub" Foreground="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap"/>

                        <StackPanel x:Name="Actions">
                            <Button x:Name="BtnStart" Content="▶  启动游戏" Style="{StaticResource PrimaryBtn}" Click="Start_Click"
                                    ToolTip="在沙箱里打开游戏；有保存的登录会自动免扫码进入"/>
                            <Button x:Name="BtnStop" Content="■  停止沙箱" Style="{StaticResource Btn}" Click="Stop_Click"
                                    ToolTip="保存当前登录后关闭沙箱里的所有程序"/>
                            <Button x:Name="BtnMem" Content="↓  释放浏览器内存" Style="{StaticResource Btn}" Click="Mem_Click"
                                    ToolTip="隐藏 QQ 浏览器窗口、回收它的内存；不影响游戏"/>
                            <Button x:Name="BtnClear" Content="⟲  清除登录 / 换号重新扫码" Style="{StaticResource DangerBtn}" Click="Clear_Click"
                                    ToolTip="删除这个沙箱保存的登录，下次启动要重新扫码；游戏包和备注保留"/>
                        </StackPanel>

                        <Separator Margin="0,6,0,12"/>
                        <TextBlock Text="账号备注" Style="{StaticResource SectionTitle}"/>
                        <DockPanel>
                            <Button x:Name="BtnNote" DockPanel.Dock="Right" Content="保存" Style="{StaticResource Btn}" Margin="8,0,0,0" Padding="12,5" Click="Note_Click"/>
                            <TextBox x:Name="TxtNote" Padding="6,5" VerticalContentAlignment="Center" KeyDown="TxtNote_KeyDown"/>
                        </DockPanel>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="桌面快捷方式会改名为「jskp-备注」。"/>

                        <Separator Margin="0,12"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BtnRole" DockPanel.Dock="Right" Content="重新读取" Style="{StaticResource LinkBtn}" Margin="0" Click="Role_Click"
                                    ToolTip="游戏开着时，从游戏里重新读一次角色名和攻击力（几秒到十几秒）"/>
                            <TextBlock Text="游戏角色" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtRole" TextWrapping="Wrap" LineHeight="20"/>

                        <Separator Margin="0,12"/>
                        <TextBlock Text="登录凭证" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="TxtCred" TextWrapping="Wrap" LineHeight="20"/>

                        <Separator Margin="0,12"/>
                        <TextBlock Text="静默保活" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="ChkKeep" Content="为选中的沙箱启用保活" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkLeanRefresh" Content="精简保活（不打开游戏中心；失败回退完整启动）" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="RadInterval" Content="每隔" VerticalAlignment="Center" GroupName="sched" Checked="Sched_Changed"/>
                            <TextBox x:Name="TxtHours" Width="38" Margin="6,0" Padding="3" HorizontalContentAlignment="Center"/>
                            <TextBlock Text="小时" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="RadDaily" Content="每天" VerticalAlignment="Center" GroupName="sched" Checked="Sched_Changed"/>
                            <TextBox x:Name="TxtHour" Width="38" Margin="6,0,2,0" Padding="3" HorizontalContentAlignment="Center"/>
                            <TextBlock Text=":" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMinute" Width="38" Margin="2,0,0,0" Padding="3" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="到点在后台冷启动一次，免扫授权换新登录后自动关闭。每天模式各号依次错开 10 分钟；游戏正开着时只保存不重启。空闲 10 天也能免扫，每天一次足够。精简保活默认关，建议先在 qb1 验证。"/>
                        <Button x:Name="BtnKeepSave" Content="保存保活设置" Style="{StaticResource Btn}" Click="KeepSave_Click"/>

                        <Separator Margin="0,6,0,12"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="打开完整日志" Style="{StaticResource LinkBtn}" Margin="0" Click="OpenLog_Click"/>
                            <TextBlock Text="最近日志" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Height="170"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,6" Background="#F8FAFC">
            <DockPanel>
                <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="120" Height="8" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus" Foreground="#334155" Text="就绪" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
