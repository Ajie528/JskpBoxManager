<Window x:Class="JskpBoxManager.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本与更新记录" Width="720" Height="600" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13" Icon="/app.ico">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtInfo" Foreground="#4B5563" Margin="0,6,0,0" LineHeight="20" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCheck" Content="检查更新" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="Check_Click"/>
            <Button Content="复制版本信息" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button Content="打开程序目录" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="OpenDir_Click"/>
            <Button Content="关闭" Style="{StaticResource Btn}" Margin="0" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="更新记录" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Padding="8" Background="#F9FAFB"/>
    </DockPanel>
</Window>
