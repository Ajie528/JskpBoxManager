<Window x:Class="JskpBoxManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="向僵多开管家" Width="1680" Height="900" MinWidth="1120" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="White" Icon="/app.ico">
    <!--
      全局 ToolTip 样式。
      原来没有任何 ToolTip 样式，WPF 默认按内容宽度铺开、又受屏幕边缘限制，
      长文本（「上次保活」那种带 ret=-13 全句说明的）会被压成很窄一条、或者被截断，
      于是提示根本读不全。这里统一成固定宽度 + 自动换行。
    -->
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#0F172A" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="向僵多开管家" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtVersion" Foreground="#94A3B8" Margin="10,5,0,0" Text="v1.0.0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnNewVersion" Visibility="Collapsed" Style="{StaticResource LinkBtn}" Foreground="#4ADE80" FontWeight="SemiBold" Margin="0,0,20,0" Click="NewVersion_Click"/>
                    <TextBlock x:Name="TxtEnv" Foreground="#CBD5E1" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <Button Content="导入旧版数据" Style="{StaticResource LinkBtn}" Foreground="#93C5FD" Click="Import_Click"/>
                    <Button Content="路径设置" Style="{StaticResource LinkBtn}" Foreground="#93C5FD" Click="Paths_Click"/>
                    <Button Content="导出诊断包" Style="{StaticResource LinkBtn}" Foreground="#93C5FD" Click="Diag_Click"/>
                    <Button Content="采集数据样板" Style="{StaticResource LinkBtn}" Foreground="#93C5FD" Click="Samples_Click"
                            ToolTip="把所有号的免扫链龄、换新次数、密钥年龄、最后返回码导成一个横向截面（只有哈希），用来对比是哪个号出了问题"/>
                    <Button Content="版本与更新记录" Style="{StaticResource LinkBtn}" Foreground="#93C5FD" Click="About_Click" Margin="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--
          提醒横幅。
          原来只是「一行 Wrap 文本」，长提示（比如 16 个沙箱的任务名全列一遍）会把
          横幅撑得很高、把下方表格挤走；窗口窄的时候又会被右侧按钮压缩到只剩一两个字一行。
          现在：文本限高约 3 行、超出滚动可鼠标滚轮翻看，按钮固定在右侧不参与换行计算。
        -->
        <Border Grid.Row="1" x:Name="Banner" Visibility="Collapsed" Background="#FEF3C7"
                BorderBrush="#F59E0B" BorderThickness="0,0,0,1" Padding="18,8">
            <DockPanel>
                <Button x:Name="BannerBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}"
                        Margin="12,0,0,0" Padding="12,4" VerticalAlignment="Center" Click="BannerBtn_Click"/>
                <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="#92400E" LineHeight="20"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--
          主体区：左侧表格 + 可拖动分隔条 + 右侧详情面板。
          原来右面板写死 420px，窗口一变宽表格就吃掉全部富余空间、右面板还是那么窄，
          里面的长句照样挤成一团。现在改成 GridSplitter + 比例宽度：
            · 右面板用 3* 的比例（约占总宽 25%），窗口拉大时它跟着变宽
            · 分隔条可手动拖动，拖动后 WPF 会把 Star 转为实际像素，之后仍随窗口缩放
            · 设 MinWidth 兜底，避免拖到看不见
        -->
        <Grid Grid.Row="2" Margin="16,14,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" MinWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- 沙箱列表 -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <CheckBox x:Name="ChkGlobalKeep" Content="静默保活总开关" VerticalAlignment="Center" Margin="0,0,14,0" Click="GlobalKeep_Click"/>
                        <CheckBox x:Name="ChkProtocol" Content="协议服务" VerticalAlignment="Center" Margin="0,0,6,0" Click="Protocol_Click"
                                  ToolTip="本机 HTTP 服务：脚本 GET /token?ref=qb1 取业务 token（自动抓包解密，需装 Wireshark）"/>
                        <TextBlock x:Name="TxtProtocol" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,8,0"
                                   Text="未启用" ToolTip="协议服务地址"/>
                        <Button Content="复制令牌" Style="{StaticResource LinkBtn}" Margin="0,0,12,0" Click="ProtocolToken_Click"
                                ToolTip="复制 JSKP_PROTOCOL_TOKEN，给脚本 Authorization: Bearer 使用"/>
                        <CheckBox x:Name="ChkAutoTrim" Content="自动压内存" VerticalAlignment="Center" Margin="0,0,4,0" Click="AutoTrim_Click"
                                  ToolTip="每隔几分钟自动压一次所有在跑的沙箱（仅 QQ 浏览器，不动游戏本体以免拖断长连接）；挂机省物理内存用，仅界面开着时生效"/>
                        <TextBox x:Name="TxtTrimMin" Width="34" Text="10" Padding="2" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="0,0,2,0" LostFocus="AutoTrim_Click"/>
                        <TextBlock Text="分" VerticalAlignment="Center" Foreground="#CBD5E1" FontSize="12" Margin="0,0,12,0"/>
                        <Button Content="＋ 新建沙箱" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="NewBox_Click"/>
                        <Button Content="刷新" Style="{StaticResource Btn}" Margin="0" Click="Refresh_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="沙箱列表" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Text="每个沙箱登录一个微信号；按住 Ctrl / Shift 可多选后批量启动、停止或设置保活"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderBrush="{StaticResource Border}"
                          SelectionMode="Extended" SelectionUnit="FullRow" CanUserResizeRows="False"
                          Background="White" RowBackground="White" AlternatingRowBackground="White"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ColumnWidth="SizeToCells" CanUserResizeColumns="True"
                          SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
                    <!--
                      行高：MinRowHeight 而不是 RowHeight。
                      RowHeight 是固定值，内容换行后第二行会被裁掉（「上次保活」就踩了这个）；
                      MinRowHeight 让行按需变高，单行内容仍是 38 的舒适高度。
                    -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <!-- Height=Auto + MinHeight：单行时保持 38 的舒适高度，
                                 内容换行成多行时由 Auto 撑高（否则第二行会被裁掉）。 -->
                            <Setter Property="Height" Value="Auto"/>
                            <Setter Property="MinHeight" Value="38"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <!-- 表头允许换行：列被拖窄时「今日换 key」这类长标题折行显示，而不是被裁掉 -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <!--
                              单元格允许内容撑高：VerticalAlignment 不能是 Center
                              （Center 会让 ContentPresenter 只取内容的首选高度并把行高压死在 38），
                              改成 Stretch 后，换行的多行文本才能把行高顶起来。
                            -->
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"
                                                              HorizontalAlignment="Stretch"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DCFCE7"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <!--
                          列宽合计必须留出「账号备注」的空间，否则整行走横向压缩、内容被截断。
                          窗口默认 1680 宽、右侧面板 420 + 间距 16 + 外边距 32，
                          表格可用约 1208；下面固定列合计 1084，剩给「账号备注」约 124。
                          最小宽度 1280 时可用约 812，会出横向滚动条（比压字好读）。

                          自适应策略：
                          · 短内容列（沙箱、攻击力、状态、登录、授权、换 key、警告）用固定像素——
                            它们的文本长度基本不变，给多了是浪费。
                          · 「账号备注」和「上次保活」用 Star 按比例吃掉剩余宽度——
                            这两列内容最长且不定长，窗口拉大时应该由它们变宽。
                          · 每列都设 MinWidth，窗口很窄时 DataGrid 出横向滚动条，
                            而不是把列压到看不见。
                        -->
                        <DataGridTextColumn Header="沙箱" Binding="{Binding Box}" Width="58">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- DataGridTextColumn 的单元格默认不换行，用 ElementStyle 打开 -->
                        <DataGridTextColumn Header="账号备注" Binding="{Binding Note}" Width="1.2*" MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,4"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="角色" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RoleText}" ToolTip="{Binding RoleTip}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="攻击力" Binding="{Binding AttackText}" Width="66">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="运行状态" Width="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 用 Grid 而不是水平 StackPanel：StackPanel 给子元素无限宽度，
                                         文字永远不会换行；Grid 才会按列宽约束换行。 -->
                                    <Grid VerticalAlignment="Center" Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding PhaseBrush}"
                                                 Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PhaseText}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" ToolTip="{Binding PhaseText}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="登录" Width="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 去掉 HorizontalAlignment="Left"：它会让 Border 按内容自适应宽度、
                                         永远不换行。改成 Stretch 后能按列宽约束换行。 -->
                                    <Border Background="{Binding LoginBg}" CornerRadius="10" Padding="8,2"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,4">
                                        <TextBlock Text="{Binding LoginText}" Foreground="{Binding LoginFg}" FontSize="12"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   ToolTip="{Binding LoginText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 「最近免扫换新」：内容过长时换行，行高随之变高 -->
                        <DataGridTemplateColumn Header="最近免扫换新" Width="112">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RenewText}" ToolTip="{Binding RenewText}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"
                                               ToolTipService.InitialShowDelay="250" ToolTipService.BetweenShowDelay="0"
                                               ToolTipService.ShowDuration="120000"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 授权剩余 -->
                        <DataGridTemplateColumn Header="授权剩余" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ScanAgeText}" Foreground="{Binding ScanAgeFg}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"
                                               ToolTip="{Binding ScanAgeTip}" ToolTipService.ShowDuration="120000" ToolTipService.InitialShowDelay="250" ToolTipService.BetweenShowDelay="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 保活计划：内容「每天 03:00·协议」较长，给足宽度让其两行内显示 -->
                        <DataGridTemplateColumn Header="保活计划" Width="124">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Keepalive}" ToolTip="{Binding Keepalive}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 「今日换 key」：内容短，但表头较长，同样允许换行 -->
                        <DataGridTemplateColumn Header="今日换 key" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RotationsText}" Foreground="{Binding RotationsFg}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"
                                               ToolTip="{Binding RotationsTip}" ToolTipService.ShowDuration="120000" ToolTipService.InitialShowDelay="250" ToolTipService.BetweenShowDelay="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 上次保活：内容最长（含 ret=-13 全句说明），优先换行而不是截断 -->
                        <DataGridTemplateColumn Header="上次保活" Width="1.6*" MinWidth="132">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastRefreshShort, Mode=OneWay, FallbackValue=读取中}"
                                               ToolTip="{Binding LastRefresh}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"
                                               ToolTipService.InitialShowDelay="250"
                                               ToolTipService.BetweenShowDelay="0"
                                               ToolTipService.ShowDuration="120000"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="26">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="⚠" Foreground="{StaticResource Warn}" ToolTip="{Binding Warning}"
                                               ToolTipService.ShowDuration="120000" ToolTipService.InitialShowDelay="250" ToolTipService.BetweenShowDelay="0" Visibility="{Binding WarningVisibility}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- 右侧详情 -->
            <!-- 可拖动分隔条：左右面板之间的宽度由用户自己掌握 -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" ShowsPreview="True" Cursor="SizeWE"/>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <StackPanel x:Name="Detail">
                        <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold" Text="请选择一个沙箱" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailSub" Foreground="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap"/>

                        <Border x:Name="ProbePanel" Background="#F1F5F9" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtProbeSummary" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="⏱ 探测计划（每号错开）" FontSize="12" FontWeight="SemiBold"/>
                                </DockPanel>
                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ProbeList"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="Actions">
                            <Button x:Name="BtnStart" Content="▶  启动游戏" Style="{StaticResource PrimaryBtn}" Click="Start_Click"
                                    ToolTip="在沙箱里打开游戏；有保存的登录会自动免扫码进入"/>
                            <Button x:Name="BtnStop" Content="■  停止沙箱" Style="{StaticResource Btn}" Click="Stop_Click"
                                    ToolTip="保存当前登录后关闭沙箱里的所有程序"/>
                            <Button x:Name="BtnMem" Content="↓  释放浏览器内存" Style="{StaticResource Btn}" Click="Mem_Click"
                                    ToolTip="隐藏 QQ 浏览器窗口、回收它的内存；不影响游戏"/>
                            <Button x:Name="BtnDeepMem" Content="↓↓  深度压缩内存（含游戏）" Style="{StaticResource Btn}" Click="DeepMem_Click"
                                    ToolTip="连游戏本体一起压工作集；数字大降但正玩会回升、提交不变。会拖断 ilink 长连接，所以常驻保活中的沙箱只压浏览器"/>
                            <Button x:Name="BtnTools" Content="🛠  高级工具（取Token / 抓包 / 解包…）" Style="{StaticResource Btn}" Click="Tools_Click"
                                    ToolTip="取业务 Token、抓 wx 请求、导 TLS 密钥、解包、Frida 观测、凭证导入导出等"/>
                            <Button x:Name="BtnScanFree" Content="⟲  免扫重试（清缓存·不重扫）" Style="{StaticResource Btn}" Click="ScanFree_Click"
                                    ToolTip="弹扫码框但其实没被顶时用：清本地会话缓存、还原金库里的免扫凭证再冷启，尽量免扫进入。若是真被顶/过期，仍会要求扫码。不会删除你的登录"/>
                            <Button x:Name="BtnRecover" Content="⟲  用历史凭证恢复（免扫·逐个试）" Style="{StaticResource Btn}" Click="Recover_Click"
                                    ToolTip="免扫重试还不行时用：列出金库+最近 30 份历史 key，可单点某把试，或自动从新到旧逐个冷启验证，第一把能免扫就停。真被顶/过期仍要扫码"/>
                            <Button x:Name="BtnProtoRenew" Content="⚡  纯协议续期（不开浏览器）" Style="{StaticResource Btn}" Click="ProtoRenew_Click"
                                    ToolTip="直接连微信服务器发 AutoAuth 换新密钥，不启动 QQ 浏览器/微信运行时，几秒完成。会轮换服务端密钥（旧 key 作废），已做发送前落盘保护"/>
                            <Button x:Name="BtnClear" Content="⟲  清除登录 / 换号重新扫码" Style="{StaticResource DangerBtn}" Click="Clear_Click"
                                    ToolTip="删除这个沙箱保存的登录，下次启动要重新扫码；游戏包和备注保留"/>
                            <Button x:Name="BtnDelete" Content="🗑  删除这个沙箱" Style="{StaticResource DangerBtn}" Click="DeleteBox_Click"
                                    ToolTip="彻底删除这个沙箱：登录、游戏包、备注、保活任务、配置、快捷方式全部清除，不可恢复"/>
                        </StackPanel>

                        <Separator Margin="0,6,0,12"/>
                        <TextBlock Text="账号备注" Style="{StaticResource SectionTitle}"/>
                        <DockPanel>
                            <Button x:Name="BtnNote" DockPanel.Dock="Right" Content="保存" Style="{StaticResource Btn}" Margin="8,0,0,0" Padding="12,5" Click="Note_Click"/>
                            <TextBox x:Name="TxtNote" Padding="6,5" VerticalContentAlignment="Center" KeyDown="TxtNote_KeyDown"/>
                        </DockPanel>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="桌面快捷方式会改名为「jskp-备注」。"/>

                        <Separator Margin="0,12"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BtnRole" DockPanel.Dock="Right" Content="重新读取" Style="{StaticResource LinkBtn}" Margin="0" Click="Role_Click"
                                    ToolTip="游戏开着时，从游戏里重新读一次角色名和攻击力（几秒到十几秒）"/>
                            <TextBlock Text="游戏角色" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtRole" TextWrapping="Wrap" LineHeight="20"/>

                        <Separator Margin="0,12"/>
                        <TextBlock Text="登录凭证" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="TxtCred" TextWrapping="Wrap" LineHeight="20"/>

                        <Separator Margin="0,12"/>
                        <TextBlock Text="静默保活" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="ChkKeep" Content="为选中的沙箱启用保活" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkResidentKeep" Margin="0,0,0,8">
                            <TextBlock Text="关游戏后常驻轻量运行时（保留 ilink 长连接；藏窗压内存，不整箱停掉）" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkProtocolRenew" Margin="0,0,0,8">
                            <TextBlock Text="保活时先用纯协议续期（不开浏览器，几秒完成；失败自动回退冷启动）" TextWrapping="Wrap"
                                       ToolTip="直接连微信服务器发 AutoAuth 换新密钥，不启动 QQ 浏览器和微信运行时，通常 2 秒内完成。成功就完全跳过冷启动；被服务端明确拒绝(-13/-14)时直接标「需要扫码」；其它失败自动回退原来的冷启动流程。"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="RadDaily" Content="每天" VerticalAlignment="Center" GroupName="sched" Checked="Sched_Changed"/>
                            <TextBox x:Name="TxtHour" Width="38" Margin="6,0,2,0" Padding="3" HorizontalContentAlignment="Center"/>
                            <TextBlock Text=":" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMinute" Width="38" Margin="2,0,0,0" Padding="3" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="RadInterval" Content="每隔" VerticalAlignment="Center" GroupName="sched" Checked="Sched_Changed"/>
                            <TextBox x:Name="TxtHours" Width="38" Margin="6,0" Padding="3" HorizontalContentAlignment="Center"/>
                            <TextBlock Text="小时" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="默认每天冷启动一次即可（各号错开 10 分钟）。越勤越容易把免扫密钥滚断：实测闲置近 3 天仍可进，而每 2 小时续期反而约一天失效。游戏开着或常驻时只保存不重启。点「停止」仍会整箱关掉。"/>

                        <Border Background="#F1F5F9" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="轮换额度（防把授权链滚废）" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="每天最多换" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtMaxRotations" Width="46" Padding="3" HorizontalContentAlignment="Center"
                                             ToolTip="每个号每天最多允许换几次 AutoAuthKey。填 0 表示用默认 8 次。"/>
                                    <TextBlock Grid.Column="2" Text="次 key" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="密钥满" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtForceHours" Width="46" Padding="3" HorizontalContentAlignment="Center"
                                             ToolTip="密钥超过这么多小时就不管计划时刻，强制续期。填 0 用默认 20 小时。"/>
                                    <TextBlock Grid.Column="2" Text="小时强制续期" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="密钥不到" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtMinKeyAge" Width="46" Padding="3" HorizontalContentAlignment="Center"
                                             ToolTip="密钥还新于这么多小时时，连日常保活也先不动它（少滚一次 = 少一次风险）。填 0 用默认 6 小时。"/>
                                    <TextBlock Grid.Column="2" Text="小时就别动它" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="TxtQuotaNow" Foreground="#475569" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnKeepSave" Content="保存保活设置" Style="{StaticResource Btn}" Click="KeepSave_Click"/>

                        <Separator Margin="0,6,0,12"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BtnNotifyOpen" DockPanel.Dock="Right" Content="设置…" Style="{StaticResource LinkBtn}" Margin="0" Click="NotifyOpen_Click"/>
                            <TextBlock Text="过期提醒（微信推送）" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtNotifySummary" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="未配置。凭证超过 20 小时没续期时推送到微信。"/>

                        <Separator Margin="0,6,0,12"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="打开完整日志" Style="{StaticResource LinkBtn}" Margin="0" Click="OpenLog_Click"/>
                            <TextBlock Text="最近日志" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <!-- 日志框用 MinHeight + 弹性高度，窗口拉高时它跟着变高，而不是固定 220 -->
                        <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" MinHeight="140"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,6" Background="#F8FAFC">
            <DockPanel>
                <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="120" Height="8" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus" Foreground="#334155" Text="就绪" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
